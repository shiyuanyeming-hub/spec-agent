# LLM 接入（兼容 OpenAI 接口：OpenAI / DeepSeek / Ollama / vLLM 均可）
# 不填 LLM_API_KEY 时自动降级为 fake 模式（确定性 Mock），不联网也能跑通全流程
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# LLM_PROVIDER=openai        # openai | fake（留空 = 有 key 用 openai，无 key 用 fake）
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=3

# 流水线
MAX_VALIDATION_ROUNDS=3
MAX_INPUT_CHARS=4000

# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
